{
  "name": "ThingAudioProcessSDK",
  "version": "1.1.3",
  "summary": "ThingAudioProcessSDK framework.",
  "homepage": "https://github.com/tuya",
  "license": "none",
  "authors": {
    "TuyaInc": "https://developer.tuya.com/"
  },
  "source": {
    "http": "https://github.com/programming086/TuyaSimulatorFixed-Binaries/releases/download/ThingAudioProcessSDK-1.1.3/ThingAudioProcessSDK.xcframework.zip",
    "type": "zip"
  },
  "platforms": {
    "ios": "11.0"
  },
  "exclude_files": [
    "ThingAudioProcessSDK/**/Android/**/*.*",
    "ThingAudioProcessSDK/include/**/*.*",
    "ThingAudioProcessSDK/include/rapidjson/msinttypes/*.*"
  ],
  "dependencies": {
    "ThingAvLoggerSDK": [],
    "ThingTensorFlowLiteC": []
  },
  "libraries": [
    "c++",
    "z",
    "iconv",
    "bz2",
    "resolv"
  ],
  "frameworks": [
    "Foundation",
    "AVFoundation",
    "Foundation",
    "CoreAudio",
    "CoreMedia",
    "CoreVideo",
    "VideoToolbox",
    "AudioToolbox"
  ],
  "pod_target_xcconfig": {
    "OTHER_CFLAGS": "-DLINUX",
    "GCC_PREPROCESSOR_DEFINITIONS": "WEBRTC_POSIX $(inherited)",
    "HEADER_SEARCH_PATHS": "$(PODS_TARGET_SRCROOT)/ThingAudioProcessSDK/include $(PODS_TARGET_SRCROOT)/ThingAudioProcessSDK/avlogger $(PODS_TARGET_SRCROOT)/ThingAudioProcessSDK/include",
    "ENABLE_BITCODE": "NO"
  },
  "user_target_xcconfig": {},
  "vendored_frameworks": [
    "ThingAudioProcessSDK.xcframework"
  ],
  "source_files": [
    "ThingAudioProcessSDK.xcframework/ios-arm64/ThingAudioProcessSDK.framework/Headers/*"
  ]
}