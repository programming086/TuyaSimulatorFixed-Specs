{
  "name": "ThingVideoCodecSDK",
  "version": "1.6.0",
  "summary": "open SDK code for tuya video codec.",
  "homepage": "https://github.com/tuya",
  "license": "none",
  "authors": {
    "TuyaInc": "https://developer.tuya.com/"
  },
  "source": {
    "http": "https://github.com/programming086/TuyaSimulatorFixed-Binaries/releases/download/ThingVideoCodecSDK-1.6.0/ThingVideoCodecSDK.xcframework.zip",
    "type": "zip"
  },
  "platforms": {
    "ios": "9.0"
  },
  "exclude_files": [
    "ThingVideoCodecSDK/**/Android/*.*",
    "ThingVideoCodecSDK/Utils/rapidjson/msinttypes/*.*"
  ],
  "ios": {},
  "dependencies": {
    "ThingFFmpegWrapper": [],
    "ThingAvLoggerSDK": []
  },
  "libraries": [
    "c++",
    "z",
    "iconv",
    "bz2",
    "resolv"
  ],
  "frameworks": [
    "Foundation",
    "AVFoundation",
    "Foundation",
    "CoreAudio",
    "CoreMedia",
    "CoreVideo",
    "VideoToolbox",
    "AudioToolbox"
  ],
  "pod_target_xcconfig": {
    "OTHER_CFLAGS": "-DLINUX",
    "OTHER_LDFLAGS": "-read_only_relocs suppress",
    "HEADER_SEARCH_PATHS": "$(PODS_TARGET_SRCROOT)/ThingVideoCodecSDK/Include/ffmpeg $(PODS_TARGET_SRCROOT)/ThingVideoCodecSDK/Include/openH264",
    "ENABLE_BITCODE": "NO",
    "STRIP_INSTALLED_PRODUCT": "YES"
  },
  "user_target_xcconfig": {
    "STRIP_INSTALLED_PRODUCT": "YES"
  },
  "vendored_frameworks": [
    "ThingVideoCodecSDK.xcframework"
  ],
  "source_files": [
    "ThingVideoCodecSDK.xcframework/ios-arm64/ThingVideoCodecSDK.framework/Headers/*"
  ]
}