{
  "name": "ThingMP3CodecSDK",
  "version": "1.0.2",
  "summary": "ThingMP3CodecSDK framework.",
  "homepage": "https://github.com/tuya",
  "license": "none",
  "authors": {
    "TuyaInc": "https://developer.tuya.com/"
  },
  "source": {
    "http": "https://github.com/programming086/TuyaSimulatorFixed-Binaries/releases/download/ThingMP3CodecSDK-1.0.2/ThingMP3CodecSDK.xcframework.zip",
    "type": "zip"
  },
  "platforms": {
    "ios": "11.0"
  },
  "exclude_files": "ThingMP3CodecSDK/**/Android/**/*.*",
  "ios": {},
  "dependencies": {
    "ThingAvLoggerSDK": []
  },
  "libraries": [
    "c++",
    "z",
    "iconv",
    "bz2",
    "resolv"
  ],
  "frameworks": [
    "Foundation",
    "AVFoundation",
    "Foundation",
    "CoreAudio",
    "CoreMedia",
    "CoreVideo",
    "VideoToolbox",
    "AudioToolbox"
  ],
  "pod_target_xcconfig": {
    "OTHER_CFLAGS": "-DLINUX",
    "GCC_PREPROCESSOR_DEFINITIONS": "WEBRTC_POSIX $(inherited)",
    "HEADER_SEARCH_PATHS": "$(PODS_TARGET_SRCROOT)/ThingMP3CodecSDK/Utils ",
    "ENABLE_BITCODE": "NO"
  },
  "user_target_xcconfig": {},
  "vendored_frameworks": [
    "ThingMP3CodecSDK.xcframework"
  ],
  "source_files": [
    "ThingMP3CodecSDK.xcframework/ios-arm64/ThingMP3CodecSDK.framework/Headers/*"
  ]
}