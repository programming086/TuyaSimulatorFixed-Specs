{
  "name": "ThingP2PSDK",
  "version": "3.4.80",
  "summary": "open SDK code for tuya p2p.",
  "description": "TODO: Add long description of the pod here.",
  "homepage": "https://developer.tuya.com/",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": {
    "Tuya": "developer@tuya.com"
  },
  "source": {
    "http": "https://github.com/programming086/TuyaSimulatorFixed-Binaries/releases/download/ThingP2PSDK-3.4.80/ThingP2PSDK.xcframework.zip",
    "type": "zip"
  },
  "platforms": {
    "ios": "11.0"
  },
  "exclude_files": [
    "ThingP2PSDK/libs/Android/*",
    "ThingP2PSDK/Platforms/Android/*"
  ],
  "ios": {},
  "dependencies": {
    "ThingMbedtls": [
      "3.3.0"
    ],
    "ThingAvLoggerSDK": []
  },
  "libraries": [
    "c++",
    "z",
    "iconv",
    "bz2",
    "resolv"
  ],
  "frameworks": [
    "Foundation",
    "AVFoundation",
    "Foundation",
    "CoreAudio",
    "CoreMedia",
    "CoreVideo",
    "VideoToolbox"
  ],
  "pod_target_xcconfig": {
    "OTHER_CFLAGS": "-DLINUX",
    "GCC_PREPROCESSOR_DEFINITIONS": "WEBRTC_POSIX HAVE_STRLCPY $(inherited)",
    "HEADER_SEARCH_PATHS": "$(PODS_TARGET_SRCROOT)/ThingP2PSDK $(PODS_TARGET_SRCROOT)/ThingP2PSDK/Platforms/iOS $(PODS_TARGET_SRCROOT)/ThingP2PSDK/Utils $(PODS_TARGET_SRCROOT)/ThingP2PSDK/LogManager $(PODS_TARGET_SRCROOT)/ThingP2PSDK/CAPI $(PODS_TARGET_SRCROOT)/include/libuv/include $(PODS_TARGET_SRCROOT)/include/libsrtp/include $(PODS_TARGET_SRCROOT)/include/mbedtls/include",
    "ENABLE_BITCODE": "NO"
  },
  "user_target_xcconfig": {},
  "vendored_frameworks": [
    "ThingP2PSDK.xcframework"
  ],
  "source_files": [
    "ThingP2PSDK.xcframework/ios-arm64/ThingP2PSDK.framework/Headers/*"
  ]
}