  },
  "user_target_xcconfig": {
    "EXCLUDED_ARCHS[sdk=iphonesimulator*]": "arm64",
    "EXCLUDED_ARCHS[sdk=watchsimulator*]": "x86_64 arm64"
  },
  "preserve_paths": "weak_deps.json",
