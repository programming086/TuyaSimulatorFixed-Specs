{
  "name": "ThingOggPackerSDK",
  "version": "1.1.1",
  "summary": "open SDK code for tuya video codec.",
  "homepage": "https://github.com/tuya",
  "license": "none",
  "authors": {
    "TuyaInc": "https://developer.tuya.com/"
  },
  "source": {
    "http": "https://github.com/programming086/TuyaSimulatorFixed-Binaries/releases/download/ThingOggPackerSDK-1.1.1/ThingOggPackerSDK.xcframework.zip",
    "type": "zip"
  },
  "platforms": {
    "ios": "9.0"
  },
  "exclude_files": "ThingOggPackerSDK/**/Android/*.*",
  "ios": {},
  "dependencies": {
    "ThingAvLoggerSDK": []
  },
  "libraries": [
    "c++",
    "z",
    "iconv",
    "bz2",
    "resolv"
  ],
  "frameworks": [
    "Foundation",
    "AVFoundation",
    "Foundation"
  ],
  "pod_target_xcconfig": {
    "OTHER_CFLAGS": "-DLINUX",
    "OTHER_LDFLAGS": "-read_only_relocs suppress",
    "HEADER_SEARCH_PATHS": "$(PODS_TARGET_SRCROOT)/ThingOggPackerSDK/Source $(PODS_TARGET_SRCROOT)/ThingOggPackerSDK/Source/ogg/include $(PODS_TARGET_SRCROOT)/ThingOggPackerSDK/Include $(PODS_TARGET_SRCROOT)/ThingOggPackerSDK/Include/avlog $(PODS_TARGET_SRCROOT)/ThingOggPackerSDK/Source/ogg/src",
    "ENABLE_BITCODE": "NO"
  },
  "user_target_xcconfig": {},
  "vendored_frameworks": [
    "ThingOggPackerSDK.xcframework"
  ],
  "source_files": [
    "ThingOggPackerSDK.xcframework/ios-arm64/ThingOggPackerSDK.framework/Headers/*"
  ]
}