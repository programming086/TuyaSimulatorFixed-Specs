{
  "name": "TencentOpenApi",
  "version": "3.3.7",
  "summary": "The Official iOS SDK of Tencent Open API.",
  "homepage": "https://github.com/tuya",
  "license": "none",
  "authors": {
    "TuyaInc": "https://developer.tuya.com/"
  },
  "source": {
    "http": "https://github.com/programming086/TuyaSimulatorFixed-Binaries/releases/download/TencentOpenApi-3.3.7/TencentOpenApi.xcframework.zip",
    "type": "zip"
  },
  "platforms": {
    "ios": "9.0"
  },
  "static_framework": true,
  "vendored_frameworks": [
    "TencentOpenApi.xcframework"
  ],
  "pod_target_xcconfig": {
    "FRAMEWORK_SEARCH_PATHS": "$(inherited)",
    "EXCLUDED_ARCHS[sdk=watchsimulator*]": "x86_64 arm64"
  },
  "libraries": [
    "iconv",
    "z",
    "c++",
    "sqlite3"
  ],
  "frameworks": [
    "Security",
    "SystemConfiguration",
    "CoreGraphics",
    "CoreTelephony",
    "WebKit"
  ],
  "user_target_xcconfig": {
    "EXCLUDED_ARCHS[sdk=watchsimulator*]": "x86_64 arm64"
  }
}