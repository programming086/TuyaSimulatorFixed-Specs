{
  "name": "TUNIIPCKit",
  "version": "6.10.5",
  "summary": "涂鸦TTT(Tuya Tied Things ) group 插件集合",
  "homepage": "https://github.com/tuya",
  "license": "none",
  "authors": {
    "TuyaInc": "https://developer.tuya.com/"
  },
  "platforms": {
    "ios": "11.0"
  },
  "source": {
    "http": "https://github.com/programming086/TuyaSimulatorFixed-Binaries/releases/download/TUNIIPCKit-6.10.5/TUNIIPCKit.xcframework.zip",
    "type": "zip"
  },
  "resource_bundles": {
    "TUNIIPCKit": [
      "ios/TUNIIPCKit/Assets/*"
    ]
  },
  "dependencies": {
    "TUNICloudStorageSignatureManager": [
      "6.4.2"
    ],
    "TUNIDLIPCManager": [
      "6.10.6"
    ],
    "TUNIIPCAppVersionManager": [
      "6.8.1"
    ],
    "TUNIIPCCameraManager": [
      "6.10.4"
    ],
    "TUNIIPCCameraSettingsManager": [
      "6.10.5"
    ],
    "TUNIIPCDoorbellManager": [
      "6.4.0"
    ]
  },
  "user_target_xcconfig": {
    "CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES": "YES"
  },
  "pod_target_xcconfig": {
    "CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES": "YES",
    "DEFINES_MODULE": "YES"
  },
  "vendored_frameworks": [
    "TUNIIPCKit.xcframework"
  ],
  "cocoapods_version": ">= 1.10"
}