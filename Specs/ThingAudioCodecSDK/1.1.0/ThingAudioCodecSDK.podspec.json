{
  "name": "ThingAudioCodecSDK",
  "version": "1.1.0",
  "summary": "open SDK code for tuya audio codec.",
  "homepage": "https://github.com/tuya",
  "license": "none",
  "authors": {
    "TuyaInc": "https://developer.tuya.com/"
  },
  "source": {
    "http": "https://github.com/programming086/TuyaSimulatorFixed-Binaries/releases/download/ThingAudioCodecSDK-1.1.0/ThingAudioCodecSDK.xcframework.zip",
    "type": "zip"
  },
  "platforms": {
    "ios": "11.0"
  },
  "exclude_files": "ThingAudioCodecSDK/**/Android/**/*.*",
  "dependencies": {
    "ThingFFmpegWrapper": [],
    "ThingAvLoggerSDK": []
  },
  "libraries": [
    "c++",
    "z",
    "iconv",
    "bz2",
    "resolv"
  ],
  "frameworks": [
    "Foundation",
    "AVFoundation",
    "CoreAudio",
    "CoreMedia",
    "CoreVideo",
    "AudioToolbox"
  ],
  "pod_target_xcconfig": {
    "HEADER_SEARCH_PATHS": "$(PODS_TARGET_SRCROOT)/ThingAudioCodecSDK/Include/ffmpeg $(PODS_ROOT)/ThingFFmpegWrapper/ThingFFmpegWrapper",
    "ENABLE_BITCODE": "NO"
  },
  "user_target_xcconfig": {},
  "vendored_frameworks": [
    "ThingAudioCodecSDK.xcframework"
  ],
  "source_files": [
    "ThingAudioCodecSDK.xcframework/ios-arm64/ThingAudioCodecSDK.framework/Headers/*"
  ]
}