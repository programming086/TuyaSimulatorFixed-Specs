{
  "name": "ThingSmartSceneKit",
  "version": "5.0.0",
  "summary": "A short description of ThingSmartSceneKit.",
  "homepage": "https://thing.com",
  "license": {
    "type": "MIT"
  },
  "authors": {
    "Tuya": "developer@tuya.com"
  },
  "source": {
    "http": "https://github.com/programming086/TuyaSimulatorFixed-Binaries/releases/download/ThingSmartSceneKit-5.0.0/ThingSmartSceneKit.xcframework.zip",
    "type": "zip"
  },
  "static_framework": true,
  "platforms": {
    "ios": "9.0",
    "watchos": "2.0"
  },
  "prefix_header_contents": [
    "#ifdef __OBJC__",
    "#import <YYModel/YYModel.h>",
    "#import \"ThingSmartSceneKit.h\"",
    "#endif"
  ],
  "dependencies": {
    "ThingSmartDeviceKit": [
      "~> 5.0"
    ],
    "ThingSmartBaseKit": [
      "~> 5.0"
    ],
    "ThingSmartSceneCoreKit": [
      "~> 5.0"
    ]
  },
  "user_target_xcconfig": {
    "CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES": "YES"
  },
  "pod_target_xcconfig": {
    "CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES": "YES"
  },
  "watchos": {
    "pod_target_xcconfig": {
      "ENABLE_BITCODE": "YES",
      "OTHER_CFLAGS": "-fembed-bitcode -Qunused-arguments"
    },
    "source_files": [
      "ThingSmartSceneKit.xcframework/watchos-arm64_arm64_32_armv7k/ThingSmartSceneKit.framework/Headers/*"
    ]
  },
  "ios": {
    "source_files": [
      "ThingSmartSceneKit.xcframework/ios-arm64/ThingSmartSceneKit.framework/Headers/*"
    ]
  },
  "vendored_frameworks": [
    "ThingSmartSceneKit.xcframework"
  ]
}