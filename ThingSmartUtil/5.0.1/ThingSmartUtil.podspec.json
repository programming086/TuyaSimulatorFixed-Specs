{
  "name": "ThingSmartUtil",
  "version": "5.0.1",
  "summary": "A short description of ThingSmartUtil.",
  "license": {
    "type": "MIT"
  },
  "authors": {
    "Tuya SDK": "developer@thing.com"
  },
  "homepage": "https://developer.thing.com/",
  "source": {
    "http": "https://github.com/programming086/TuyaSimulatorFixed-Binaries/releases/download/ThingSmartUtil-5.0.1/ThingSmartUtil.xcframework.zip",
    "type": "zip"
  },
  "platforms": {
    "ios": "9.0",
    "watchos": "2.0"
  },
  "ios": {
    "frameworks": [
      "CoreTelephony",
      "Foundation",
      "SystemConfiguration",
      "UIKit"
    ],
    "resources": "ThingSmartUtil.xcframework/**/*.bundle",
    "dependencies": {
      "ThingMbedtls": [
        "~> 3.1.5"
      ],
      "ThingOpenSSLSDK": [
        "~> 1.1.1-s.1"
      ]
    }
  },
  "watchos": {
    "resources": "ThingSmartUtil.xcframework/**/*.bundle",
    "frameworks": "WatchKit"
  },
  "vendored_frameworks": [
    "ThingSmartUtil.xcframework"
  ],
  "cocoapods_version": ">= 1.10",
  "user_target_xcconfig": {
    "CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES": "YES"
  },
  "pod_target_xcconfig": {
    "CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES": "YES",
    "DEFINES_MODULE": "YES"
  }
}