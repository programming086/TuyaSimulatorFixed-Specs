{
  "name": "ThingAudioEngineSDK",
  "version": "1.2.5",
  "summary": "ThingAudioEngineSDK framework.",
  "description": "TODO: Add long description of the pod here.",
  "homepage": "https://developer.tuya.com/",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": {
    "Tuya": "developer@tuya.com"
  },
  "source": {
    "http": "https://github.com/programming086/TuyaSimulatorFixed-Binaries/releases/download/ThingAudioEngineSDK-1.2.5/ThingAudioEngineSDK.xcframework.zip",
    "type": "zip"
  },
  "platforms": {
    "ios": "9.0"
  },
  "exclude_files": [
    "ThingAudioEngineSDK/**/Android/**/*.*",
    "ThingAudioEngineSDK/include/**/*.*"
  ],
  "dependencies": {
    "ThingAvLoggerSDK": []
  },
  "libraries": [
    "c++",
    "z",
    "iconv",
    "bz2",
    "resolv"
  ],
  "frameworks": [
    "Foundation",
    "AVFoundation",
    "Foundation",
    "CoreAudio",
    "CoreMedia",
    "CoreVideo",
    "VideoToolbox",
    "AudioToolbox"
  ],
  "pod_target_xcconfig": {
    "OTHER_CFLAGS": "-DLINUX",
    "GCC_PREPROCESSOR_DEFINITIONS": "WEBRTC_POSIX $(inherited)",
    "HEADER_SEARCH_PATHS": "$(PODS_TARGET_SRCROOT)/ThingAudioEngineSDK/include $(PODS_TARGET_SRCROOT)/ThingAudioEngineSDK/audio-engine $(PODS_TARGET_SRCROOT)/ThingAudioEngineSDK/audio-logger $(PODS_TARGET_SRCROOT)/ThingAudioEngineSDK/audio-player $(PODS_TARGET_SRCROOT)/ThingAudioEngineSDK/audio-processer  $(PODS_TARGET_SRCROOT)/ThingAudioEngineSDK/audio-recorder $(PODS_TARGET_SRCROOT)/ThingAudioEngineSDK $(PODS_TARGET_SRCROOT)/ThingAudioEngineSDK/include/tyap $(PODS_TARGET_SRCROOT)/ThingAudioEngineSDK/vad $(PODS_TARGET_SRCROOT)/ThingAudioEngineSDK/utils $(PODS_TARGET_SRCROOT)/ThingAudioEngineSDK/interface",
    "ENABLE_BITCODE": "NO"
  },
  "user_target_xcconfig": {},
  "vendored_frameworks": [
    "ThingAudioEngineSDK.xcframework"
  ],
  "source_files": [
    "ThingAudioEngineSDK.xcframework/ios-arm64/ThingAudioEngineSDK.framework/Headers/*"
  ]
}